        <mxCell id="nota" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;fontStyle=0" value="Recepcionista, administrador, financeiro, laboratório e farmácia não têm tabela própria: o perfil fica em USUARIOS.tipo. A senha fica no Supabase Auth (AUTH.USERS)." vertex="1">
