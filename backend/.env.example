# Porta da API (o frontend, pelo proxy do Vite, espera a 3000)
PORT=3000
# Endereço do frontend (CORS)
FRONTEND_URL=http://localhost:5173
# Troque por um valor aleatório e longo
JWT_SECRET=troque-este-valor

# Supabase: Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave pública (publishable / anon): usada só para conferir a senha no login
SUPABASE_ANON_KEY=
# chave secreta (secret / service_role): NUNCA coloque no frontend
SUPABASE_SERVICE_ROLE_KEY=

# Valor padrão da consulta particular (R$)
VALOR_CONSULTA=180
# Pasta onde ficam os arquivos de resultado de exame
UPLOADS_DIR=./uploads
